{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchwork",
  "version": "0.1.0",
  "identifier": "app.patchwork",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Patchwork",
        "width": 1400,
        "height": 900,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["patchwork"],
        "name": "Patchwork board",
        "description": "Patchwork board",
        "mimeType": "application/x-patchwork",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
